\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {CPR: accuracy and reasoning co-evolve.} Both metrics are normalized (0 = worst, 1 = best) for direct comparison. After a brief dip at step 700, accuracy and Match-F1 rise together through step 2400. This co-evolution is unique to CPR: Composite shows divergence (high accuracy, low F1) and Answer-Only shows stagnation (high accuracy, flat F1).}}{4}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cpr_dynamics}{{5}{4}{\textbf {CPR: accuracy and reasoning co-evolve.} Both metrics are normalized (0 = worst, 1 = best) for direct comparison. After a brief dip at step 700, accuracy and Match-F1 rise together through step 2400. This co-evolution is unique to CPR: Composite shows divergence (high accuracy, low F1) and Answer-Only shows stagnation (high accuracy, flat F1)}{figure.caption.10}{}}
\newlabel{fig:cpr_dynamics@cref}{{[figure][5][]5}{[1][4][]4}}
