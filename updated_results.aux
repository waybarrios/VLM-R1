\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Accuracy alone is misleading.} Answer-Only reaches the highest accuracy (44.90\%) but its Match-F1 stays flat (see Figure~\ref {fig:f1_traj}), meaning reasoning never improves. Composite collapses at step 600. CPR sacrifices 3.5pp accuracy to gain +32\% in reasoning quality, the only strategy that improves both.}}{2}{figure.caption.7}\protected@file@percent }
\newlabel{fig:acc_traj}{{3}{2}{\textbf {Accuracy alone is misleading.} Answer-Only reaches the highest accuracy (44.90\%) but its Match-F1 stays flat (see Figure~\ref {fig:f1_traj}), meaning reasoning never improves. Composite collapses at step 600. CPR sacrifices 3.5pp accuracy to gain +32\% in reasoning quality, the only strategy that improves both}{figure.caption.7}{}}
